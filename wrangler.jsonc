{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "med-test",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "med-test"
    }
  ],
  "vars": {
    "DEMO_FIXED_NOW": "2026-10-13T10:00:00+08:00"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO_STATE",
        "class_name": "DemoState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DemoState"
      ]
    }
  ]
}
