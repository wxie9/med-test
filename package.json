{
  "name": "med-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/generate-seed.ts",
    "demo": "node -e \"require('fs').existsSync('data/seed/cohort.json')||require('child_process').execSync('npm run seed',{stdio:'inherit'})\" && next dev -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "prebuild": "npm run seed",
    "build:worker": "tsx scripts/build-worker-safe.ts",
    "preview:worker": "npm run build:worker && wrangler dev",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "test:worker-state": "node --import tsx tests/integration/worker-state/run.mjs"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.3",
    "seedrandom": "^3.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.11",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "postcss": "8.5.30",
    "glob": "10.5.0"
  }
}
